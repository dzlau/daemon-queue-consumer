{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'Static pages are served from public/'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/orders.py": {
      "excludeFiles": "{.env*,.agents/**,.claude/**,skills-lock.json,.vercel_python_packages/**,public/**,Dockerfile,README.md}"
    }
  },
  "daemons": {
    "queue-consumer": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "instances": {
        "iad1": 1
      }
    }
  }
}
